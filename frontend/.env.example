# Sync dashboard — Neon PostgreSQL
# Dashboard and Digital Menu share the same database so kitchen orders
# from the menu appear on this dashboard.
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xxxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require"

# Generate with: npx auth secret
AUTH_SECRET="generate-a-long-random-string"
# Local only. Do NOT set AUTH_URL on Vercel — a wrong value (e.g. localhost)
# makes every login redirect point at that host. AUTH_TRUST_HOST lets Auth.js
# derive the origin from the request instead.
AUTH_URL="http://localhost:3001"
AUTH_TRUST_HOST="true"
# PIN required to open Reports in the dashboard (default 1234 if unset)
REPORTS_PIN="1234"
# Deployed Digital Menu URL
NEXT_PUBLIC_SITE_URL="https://sync-digital-menu.vercel.app"

# Set on Vercel only. When present, menu image uploads are stored in Vercel Blob
# and an absolute public URL is saved. Leave unset locally to write into
# public/uploads/menu instead.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
